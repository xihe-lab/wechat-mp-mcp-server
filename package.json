{
  "name": "@xihe-lab/wechat-mp-mcp-server",
  "version": "0.2.0",
  "description": "WeChat Official Account (公众号) MCP Server — 25 tools spanning official API, editor channel and HTML lint: media, drafts, long-form publishing and stats via AI assistants",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "main": "dist/index.js",
  "bin": {
    "wechat-mp-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "prepublishOnly": "pnpm type-check && pnpm test && pnpm build",
    "build": "vite build",
    "dev": "vite",
    "lint": "eslint src --ext ts,tsx",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.10.0",
    "form-data": "^4.0.5",
    "playwright-core": "^1.63.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "tsx": "^4.22.4",
    "typescript": "^5.3.3",
    "vite": "^5.1.0",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "wechat",
    "weixin",
    "wechat-mp",
    "official-account",
    "gongzhonghao",
    "公众号",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "cursor",
    "draft",
    "publishing",
    "automation"
  ],
  "author": "xihe-lab",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xihe-lab/wechat-mp-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/xihe-lab/wechat-mp-mcp-server/issues"
  },
  "homepage": "https://github.com/xihe-lab/wechat-mp-mcp-server#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
